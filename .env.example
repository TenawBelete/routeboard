# Copy to .env and edit. .env is never committed.

# --- RIS Live ---------------------------------------------------------------
# RIPE asks every client to identify itself. Use something that names you
# or the project, e.g. bgp-pipeline-yourgithubname
RIS_CLIENT=bgp-pipeline-changeme
# Comma-separated route collectors (rrc00, rrc03, ...). Empty = all collectors.
RIS_HOSTS=
# Keep 1 message out of every N. 50 matches the original course project.
SAMPLE_EVERY=50

# --- Kafka (Redpanda) --------------------------------------------------------
KAFKA_TOPIC=ris.updates.raw
REDPANDA_MEMORY=1G
# Keep raw messages for 6 hours, at most 1 GiB per partition (3 partitions).
TOPIC_RETENTION_MS=21600000
TOPIC_RETENTION_BYTES=1073741824

# --- Postgres (serving layer) ------------------------------------------------
POSTGRES_DB=bgp
POSTGRES_USER=bgp
POSTGRES_PASSWORD=change-me-locally-and-use-a-strong-one-on-the-server

# --- Object storage: SeaweedFS (stage 2b) ------------------------------------
# Credentials for the S3 API. Change both on the server.
S3_ACCESS_KEY=bgp-pipeline
S3_SECRET_KEY=change-me-locally-and-use-a-strong-one-on-the-server
SEAWEEDFS_VERSION=3.80

# --- Data retention (stage 2b) -----------------------------------------------
# Bronze = raw copy of every sampled message. Silver = one row per prefix event.
# Daily summaries and Postgres KPIs are kept forever.
RETENTION_BRONZE_DAYS=3
RETENTION_SILVER_DAYS=14
# When the nightly maintenance job runs (cron syntax, UTC).
MAINTENANCE_HOUR_UTC=3
MAINTENANCE_MINUTE_UTC=15

# --- Spark streaming job (stage 2) -------------------------------------------
# Connector jars Spark downloads on first start. Do not edit unless upgrading.
SPARK_PACKAGES=org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.3,io.delta:delta-spark_2.12:3.2.0,org.postgresql:postgresql:42.7.4,org.apache.hadoop:hadoop-aws:3.3.4
# How often a micro-batch runs, in seconds.
TRIGGER_SECONDS=30
# Memory for Spark. Lower these if your Mac feels slow; raise on the server.
SPARK_DRIVER_MEMORY=2g
SPARK_CONTAINER_MEMORY=3g
# Max Kafka messages per micro-batch (protects memory when catching up).
MAX_OFFSETS_PER_TRIGGER=50000

# Password of the read-only database account the API uses (created automatically).
API_DB_PASSWORD=change-me-too

# --- Public site (see docs/DEPLOY_CLOUDFLARE.md) ------------------------------------
# Shared secret with the Cloudflare offline Worker. `make setup` fills it in.
OFFLINE_KEY=change-me
# When the site is public, uncomment these four:
# SITE_URL=https://butenai.com
# CORS_ORIGINS=https://butenai.com,https://www.butenai.com
# API_DOCS=false
# LIVE_MAX_PER_IP=4
