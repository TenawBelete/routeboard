# Copy to .env and edit. .env is never committed.

# --- RIS Live ---------------------------------------------------------------
# RIPE asks every client to identify itself. Use something that names you
# or the project, e.g. bgp-pipeline-yourgithubname
RIS_CLIENT=bgp-pipeline-changeme
# Comma-separated route collectors (rrc00, rrc03, ...). Empty = all collectors.
RIS_HOSTS=
# Keep 1 message out of every N. 50 matches the original course project.
SAMPLE_EVERY=50

# --- Kafka (Redpanda) --------------------------------------------------------
KAFKA_TOPIC=ris.updates.raw
REDPANDA_MEMORY=1G
# Keep raw messages for 6 hours, at most 1 GiB per partition (3 partitions).
TOPIC_RETENTION_MS=21600000
TOPIC_RETENTION_BYTES=1073741824

# --- Postgres (serving layer) ------------------------------------------------
POSTGRES_DB=bgp
POSTGRES_USER=bgp
POSTGRES_PASSWORD=change-me-locally-and-use-a-strong-one-on-the-server

# --- Spark streaming job (stage 2) -------------------------------------------
# How often a micro-batch runs, in seconds.
TRIGGER_SECONDS=30
# Memory for Spark. Lower these if your Mac feels slow; raise on the server.
SPARK_DRIVER_MEMORY=2g
SPARK_CONTAINER_MEMORY=3g
# Max Kafka messages per micro-batch (protects memory when catching up).
MAX_OFFSETS_PER_TRIGGER=50000
