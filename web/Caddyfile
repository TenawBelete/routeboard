# SITE_ADDRESS is ":80" locally (plain HTTP) and your domain in production,
# in which case Caddy obtains and renews the HTTPS certificate by itself.
{$SITE_ADDRESS::80} {
	@static not path /live/*
	encode @static zstd gzip

	handle /api/* {
		reverse_proxy api:8000
	}
	# Live stream: long-lived responses, flushed to the browser immediately.
	handle /live/* {
		reverse_proxy live:8001 {
			flush_interval -1
		}
	}
	handle /health {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	# The API's own documentation page loads its viewer from a CDN, so the strict policy covers the site only.
	@site not path /api/* /live/*
	header @site {
		# Everything is served from this origin: no third-party scripts, fonts or trackers.
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}
	@map path /world.json
	header @map Cache-Control "public, max-age=604800"
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
}
